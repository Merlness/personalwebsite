package components

templ Home() {
	@Layout("Personal Website") {
		<link href={ "/assets/css/chart.css?v=" + assetVersion } rel="stylesheet"/>
		<script>try { if (location.hash === "#cover") sessionStorage.removeItem("firstLight"); if (sessionStorage.getItem("firstLight")) document.documentElement.classList.add("sc-seen"); } catch (e) {}</script>
		<div class="sc-cover" id="cover">
			<div class="sc-cover-inner">
				<div class="mono" style="color:var(--dim)">33.49° N · 111.93° W · Scottsdale, Arizona</div>
				<h1>Merl <em>Martin</em></h1>
				<p>Photographer, engineer, former physics teacher. Point the telescope anywhere.</p>
				<button class="lens-button" id="sc-open" type="button" aria-label="First light. Open the star chart.">
					<span class="lens" aria-hidden="true">
						@templ.Raw(coverAperture)
					</span>
					<span class="lens-label mono">First light</span>
				</button>
			</div>
		</div>
		<div class="sc">
			<div class="stage" id="chart" tabindex="-1">
				<svg class="chart" viewBox="0 0 1000 1000" role="img" aria-label="Star chart. Each constellation opens a part of the site.">
					<defs>
						<radialGradient id="way" cx="50%" cy="50%" r="50%">
							<stop offset="0" stop-color="#f4b223" stop-opacity="0.34"></stop>
							<stop offset="0.35" stop-color="#e8467c" stop-opacity="0.3"></stop>
							<stop offset="0.7" stop-color="#6b3fa0" stop-opacity="0.22"></stop>
							<stop offset="1" stop-color="#6b3fa0" stop-opacity="0"></stop>
						</radialGradient>
						<linearGradient id="heat" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1000" y2="1000">
							<stop offset="0" stop-color="#f4b223"></stop>
							<stop offset="1" stop-color="#e8467c"></stop>
						</linearGradient>
						<clipPath id="disc"><circle cx="500" cy="500" r="440"></circle></clipPath>
					</defs>
					<circle class="spice" cx="500" cy="500" r="470" stroke="#6b3fa0"></circle>
					<circle class="spice" cx="500" cy="500" r="463" stroke="#e8467c"></circle>
					<circle class="spice" cx="500" cy="500" r="456" stroke="#f4b223"></circle>
					<circle class="ring edge" cx="500" cy="500" r="440"></circle>
					<g clip-path="url(#disc)">
						<g class="field" id="field">
							<ellipse class="way" cx="500" cy="500" rx="520" ry="150" transform="rotate(-32 500 500)"></ellipse>
						</g>
						<circle class="ring" cx="500" cy="500" r="330"></circle>
						<circle class="ring" cx="500" cy="500" r="220"></circle>
						<circle class="ring" cx="500" cy="500" r="110"></circle>
						<g id="spokes"></g>
						<path class="meteor" d="M820 120 L330 560"></path>
						<path class="meteor m2" d="M180 200 L640 700"></path>
					</g>
					<text class="tick" x="500" y="38">NORTE</text>
					<text class="tick" x="500" y="982">SUR</text>
					<text class="tick" x="26" y="505" transform="rotate(-90 26 505)">ESTE</text>
					<text class="tick" x="974" y="505" transform="rotate(90 974 505)">OESTE</text>
					<g id="constellations"></g>
				</svg>
				<aside class="plate" aria-live="polite">
					<figure>
						<img id="p-img" src="/assets/portfolio/RoadTrip2020/DSC02738_w1600.jpg" alt=""/>
					</figure>
					<div class="mono" style="color:var(--marigold);margin-top:1rem">Now in the eyepiece</div>
					<h2 id="p-title">Photography</h2>
					<p id="p-text">Landscapes, wildlife, and the night sky.</p>
					<dl class="mono" id="p-data"></dl>
					<a class="go mono" id="p-go" href="/portfolio">Open the plates →</a>
					<div class="moon mono">
						<svg id="moon" width="34" height="34" viewBox="-17 -17 34 34" aria-hidden="true"></svg>
						<span><span id="moon-text">Moon tonight</span><br/><span id="readout"></span></span>
					</div>
				</aside>
			</div>
			<p class="motto">No soy de aquí, <span>ni soy de allá.</span></p>
			<ul class="list mono" aria-label="Site sections">
				<li><a href="/portfolio">Photography</a></li>
				<li><a href="/journeys">Journeys</a></li>
				<li><a href="/blog">Journal</a></li>
				<li><a href="https://bennusystems.com">Tech</a></li>
				<li><a href="/about">About</a></li>
			</ul>
		</div>
		<div class="sc-fade" aria-hidden="true"></div>
		<script defer src={ "/assets/js/chart.js?v=" + assetVersion }></script>
	}
}
