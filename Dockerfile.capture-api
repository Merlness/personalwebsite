FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/capture-api ./cmd/capture-api
COPY internal/captureapi ./internal/captureapi
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /capture-api ./cmd/capture-api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /capture-api /capture-api
EXPOSE 8080
CMD ["/capture-api"]
