FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/personal-api ./cmd/personal-api
COPY internal/captureapi ./internal/captureapi
COPY internal/agent ./internal/agent
COPY internal/lifeorg ./internal/lifeorg
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /personal-api ./cmd/personal-api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /personal-api /personal-api
EXPOSE 8080
CMD ["/personal-api"]
